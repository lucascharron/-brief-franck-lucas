      {
        "id": 2,
        "question": "Pour l'entretien de l'iris, quelle quantité d'eau faut-il mettre dans le vase ?",
        "choix": [
          "Peu d'eau",
          "Beaucoup d'eau",
          "Le vase rempli à ras bord",
