{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portraits du quiz « Quelle fleur êtes-vous ? »",
  "description": "Liste des portraits lue par l'application. Une valeur inconnue vaut null et sa clé figure dans a_verifier.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "nom", "titre", "description", "conseil", "a_verifier"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z]+(-[a-z]+)*$" },
      "nom": { "type": "string", "minLength": 1 },
      "titre": { "type": "string", "minLength": 1, "maxLength": 60 },
      "description": { "type": "string", "minLength": 1, "maxLength": 300 },
      "conseil": { "type": ["string", "null"] },
      "a_verifier": {
        "type": "array",
        "uniqueItems": true,
        "items": { "type": "string", "enum": ["nom", "titre", "description", "conseil"] }
      }
    }
  }
}
